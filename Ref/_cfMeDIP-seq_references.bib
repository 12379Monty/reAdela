	doi = {10.1038/s43018-026-01116-3},
	id = {Zeng2026},
	isbn = {2662-1347},
	journal = {Nature Cancer},
	number = {2},
	pages = {384--398},
	title = {A pan-cancer compendium of 1,294 plasma cell-free DNA methylomes and fragmentomes enabling multicancer detection},
